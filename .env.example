# Copiá este archivo como .env y completalo.

# Dominio con el que se entra a la app (ej. obras.tuempresa.com.ar, o uno gratis de DuckDNS).
# Tiene que apuntar a este servidor: Caddy saca solo el certificado HTTPS.
DOMINIO=obras.tuempresa.com.ar

# Contraseña de la base de datos (inventá una larga).
DB_PASSWORD=

# Frase larga y al azar que firma las sesiones (ej. la salida de: openssl rand -hex 32).
SECRETO=

# Contraseña inicial del usuario "admin" (después se cambia desde la app: menú → Cambiar contraseña).
ADMIN_CLAVE=
